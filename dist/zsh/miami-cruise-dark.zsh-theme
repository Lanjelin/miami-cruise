setopt prompt_subst

# One Git status call per prompt; no extra plugin or Python required.
# + counts staged files, ! unstaged files, ? untracked files, and × conflicts.
function miami_cruise_git_status() {
  local git_output line branch='' oid='' ahead=0 behind=0 staged=0 changed=0 untracked=0 conflicts=0 xy
  git_output=$(GIT_OPTIONAL_LOCKS=0 command git status --porcelain=v2 --branch --untracked-files=normal 2>/dev/null) || return
  for line in "${(@f)git_output}"; do
    case "$line" in
      '# branch.head '*) branch=${line#\# branch.head } ;;
      '# branch.oid '*) oid=${line#\# branch.oid } ;;
      '# branch.ab '*)
        local -a counts
        counts=("${(s: :)line}")
        ahead=${counts[3]#+}
        behind=${counts[4]#-}
        ;;
      '1 '*|'2 '*)
        xy=${line[3,4]}
        [[ $xy[1] != '.' ]] && (( staged++ ))
        [[ $xy[2] != '.' ]] && (( changed++ ))
        ;;
      'u '*) (( conflicts++ )) ;;
      '? '*) (( untracked++ )) ;;
    esac
  done
  [[ -n $branch ]] || return
  [[ $branch == '(detached)' ]] && branch=${oid[1,7]}
  print -nr -- "%F{#ecd065}${branch//\%/%%}"
  (( ahead > 0 )) && print -nr -- " %F{#5ed99e}⇡${ahead}"
  (( behind > 0 )) && print -nr -- " %F{#fd717c}⇣${behind}"
  (( staged > 0 )) && print -nr -- " %F{#5ed99e}+${staged}"
  (( changed > 0 )) && print -nr -- " %F{#ecd065}!${changed}"
  (( untracked > 0 )) && print -nr -- " %F{#70d5ed}?${untracked}"
  (( conflicts > 0 )) && print -nr -- " %F{#fd717c}×${conflicts}"
  print -nr -- '%f'
}

() {
  local PR_USER PR_USER_OP PR_PROMPT PR_HOST

  if [[ $UID -ne 0 ]]; then
    PR_USER='%F{#5ed99e}%n%f'
    PR_USER_OP='%F{#5ed99e}%#%f'
    PR_PROMPT='%F{#ff7fc0}➤%f '
  else
    PR_USER='%F{#fd717c}%n%f'
    PR_USER_OP='%F{#fd717c}%#%f'
    PR_PROMPT='%F{#fd717c}➤%f '
  fi

  if [[ -n "$SSH_CLIENT" || -n "$SSH2_CLIENT" ]]; then
    PR_HOST='%F{#fd717c}%M%f'
  else
    PR_HOST='%F{#5ed99e}%m%f'
  fi

  local return_code="%(?..%F{#fd717c}%? ↵%f)"
  local user_host="${PR_USER}%F{#70d5ed}@${PR_HOST}"
  local current_dir="%B%F{#70d5ed}%~%f%b"
  local git_branch='$(miami_cruise_git_status)'
  local venv_prompt='$(virtualenv_prompt_info)'

  PROMPT="%F{#9fbabf}╭─%f${venv_prompt}${user_host} ${current_dir} \$(ruby_prompt_info) ${git_branch}
%F{#9fbabf}╰─%f$PR_PROMPT "
  RPROMPT="${return_code}"

  ZSH_THEME_RUBY_PROMPT_PREFIX="%F{#fd717c}‹"
  ZSH_THEME_RUBY_PROMPT_SUFFIX='›%f'
  ZSH_THEME_VIRTUALENV_PREFIX="%F{#fd717c}("
  ZSH_THEME_VIRTUALENV_SUFFIX=')%f '
}
