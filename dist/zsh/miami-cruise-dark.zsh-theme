setopt prompt_subst

() {
  local PR_USER PR_USER_OP PR_PROMPT PR_HOST

  if [[ $UID -ne 0 ]]; then
    PR_USER='%F{#5ed99e}%n%f'
    PR_USER_OP='%F{#5ed99e}%#%f'
    PR_PROMPT='%F{#ff7fc0}➤%f '
  else
    PR_USER='%F{#fd717c}%n%f'
    PR_USER_OP='%F{#fd717c}%#%f'
    PR_PROMPT='%F{#fd717c}➤%f '
  fi

  if [[ -n "$SSH_CLIENT" || -n "$SSH2_CLIENT" ]]; then
    PR_HOST='%F{#fd717c}%M%f'
  else
    PR_HOST='%F{#5ed99e}%m%f'
  fi

  local return_code="%(?..%F{#fd717c}%? ↵%f)"
  local user_host="${PR_USER}%F{#70d5ed}@${PR_HOST}"
  local current_dir="%B%F{#70d5ed}%~%f%b"
  local git_branch='$(git_prompt_info)'
  local venv_prompt='$(virtualenv_prompt_info)'

  PROMPT="%F{#9fbabf}╭─%f${venv_prompt}${user_host} ${current_dir} \$(ruby_prompt_info) ${git_branch}
%F{#9fbabf}╰─%f$PR_PROMPT "
  RPROMPT="${return_code}"

  ZSH_THEME_GIT_PROMPT_PREFIX="%F{#ecd065}‹"
  ZSH_THEME_GIT_PROMPT_SUFFIX='› %f'
  ZSH_THEME_RUBY_PROMPT_PREFIX="%F{#fd717c}‹"
  ZSH_THEME_RUBY_PROMPT_SUFFIX='›%f'
  ZSH_THEME_VIRTUALENV_PREFIX="%F{#fd717c}("
  ZSH_THEME_VIRTUALENV_SUFFIX=')%f '
}
