#
# Permission is hereby granted, free of charge, to any person obtaining a copy
# of this software and associated documentation files (the "Software"), to deal
# in the Software without restriction, including without limitation the rights
# to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
#
# The above copyright notice and this permission notice shall be included in all
# copies or substantial portions of the Software.
#
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
# SOFTWARE.
setopt prompt_subst

# One Git status call per prompt; no extra plugin or Python required.
# + counts staged files, ! unstaged files, ? untracked files, and × conflicts.
function miami_cruise_git_status() {
  local git_output line branch='' oid='' ahead=0 behind=0 staged=0 changed=0 untracked=0 conflicts=0 xy
  git_output=$(GIT_OPTIONAL_LOCKS=0 command git status --porcelain=v2 --branch --untracked-files=normal 2>/dev/null) || return
  for line in "${(@f)git_output}"; do
    case "$line" in
      '# branch.head '*) branch=${line#\# branch.head } ;;
      '# branch.oid '*) oid=${line#\# branch.oid } ;;
      '# branch.ab '*)
        local -a counts
        counts=("${(s: :)line}")
        ahead=${counts[3]#+}
        behind=${counts[4]#-}
        ;;
      '1 '*|'2 '*)
        xy=${line[3,4]}
        [[ $xy[1] != '.' ]] && (( staged++ ))
        [[ $xy[2] != '.' ]] && (( changed++ ))
        ;;
      'u '*) (( conflicts++ )) ;;
      '? '*) (( untracked++ )) ;;
    esac
  done
  [[ -n $branch ]] || return
  [[ $branch == '(detached)' ]] && branch=${oid[1,7]}
  print -nr -- "%F{#906b00}${branch//\%/%%}"
  (( ahead > 0 )) && print -nr -- " %F{#008254}⇡${ahead}"
  (( behind > 0 )) && print -nr -- " %F{#c8414c}⇣${behind}"
  (( staged > 0 )) && print -nr -- " %F{#008254}+${staged}"
  (( changed > 0 )) && print -nr -- " %F{#906b00}!${changed}"
  (( untracked > 0 )) && print -nr -- " %F{#007c91}?${untracked}"
  (( conflicts > 0 )) && print -nr -- " %F{#c8414c}×${conflicts}"
  print -nr -- '%f'
}

# Keep short paths whole; when a path exceeds 80 columns (or a narrow terminal), abbreviate intermediate components
# to their shortest unique sibling prefixes. Keep the last and project roots whole.
function miami_cruise_dir() {
  local display suffix parent full part marker other sibling prefix shown
  local -a parts
  local budget=80 shorten=0 i n unique anchor
  if [[ $PWD == $HOME ]]; then
    print -nr -- '%B%F{#007c91}~%f%b'
    return
  elif [[ $PWD == $HOME/* ]]; then
    display="~${PWD#$HOME}"
    suffix=${PWD#$HOME/}
    parent=$HOME
    print -nr -- '%B%F{#007c91}~%f%b'
  else
    display=$PWD
    suffix=${PWD#/}
    parent=/
    print -nr -- '%B%F{#007c91}/%f%b'
  fi
  parts=("${(@s:/:)suffix}")
  if (( COLUMNS > 0 && COLUMNS - 30 < budget )); then
    budget=$(( COLUMNS - 30 ))
  fi
  (( budget < 25 )) && budget=25
  (( ${#display} > budget )) && shorten=1
  for (( i=1; i<=${#parts}; i++ )); do
    part=$parts[i]
    full="${parent%/}/$part"
    shown=$part
    anchor=0
    [[ $parent == / && $i == 1 ]] && anchor=1
    if (( shorten && ! anchor && i < ${#parts} )); then
      for marker in .bzr .citc .git .hg .node-version .python-version .go-version .ruby-version .lua-version .java-version .perl-version .php-version .tool-versions .mise.toml .shorten_folder_marker .svn .terraform CVS Cargo.toml composer.json go.mod package.json stack.yaml; do
        [[ -e "$full/$marker" ]] && { anchor=1; break; }
      done
      if (( ! anchor )); then
        for (( n=1; n<${#part}; n++ )); do
          prefix=$part[1,n]
          unique=1
          for other in "$parent"/*(ND/); do
            [[ $other == $full ]] && continue
            sibling=${other:t}
            if [[ $sibling[1,n] == $prefix ]]; then
              unique=0
              break
            fi
          done
          (( unique )) && break
        done
        shown=$part[1,n]
      fi
    fi
    if [[ $parent == / && $i == 1 ]]; then
      print -nr -- "%B%F{#007c91}${shown//\%/%%}%f%b"
    elif (( shorten && ! anchor && i < ${#parts} )); then
      print -nr -- "/%F{#3a5157}${shown//\%/%%}%f"
    else
      print -nr -- "/%B%F{#007c91}${shown//\%/%%}%f%b"
    fi
    parent=$full
  done
}

() {
  local PR_USER PR_USER_OP PR_PROMPT PR_HOST

  if [[ $UID -ne 0 ]]; then
    PR_USER='%F{#008254}%n%f'
    PR_USER_OP='%F{#008254}%#%f'
    PR_PROMPT='%F{#b51c79}➤%f '
  else
    PR_USER='%F{#c8414c}%n%f'
    PR_USER_OP='%F{#c8414c}%#%f'
    PR_PROMPT='%F{#c8414c}➤%f '
  fi

  if [[ -n "$SSH_CLIENT" || -n "$SSH2_CLIENT" ]]; then
    PR_HOST='%F{#c8414c}%M%f'
  else
    PR_HOST='%F{#008254}%m%f'
  fi

  local return_code="%(?..%F{#c8414c}%? ↵%f)"
  local user_host="${PR_USER}%F{#007c91}@${PR_HOST}"
  local current_dir='$(miami_cruise_dir)'
  local git_branch='$(miami_cruise_git_status)'
  local venv_prompt='$(virtualenv_prompt_info)'

  if [[ ${MIAMI_CRUISE_SINGLE_LINE:-0} == 1 ]]; then
    PROMPT="${venv_prompt}${user_host} ${current_dir} \$(ruby_prompt_info) ${git_branch} $PR_PROMPT "
  else
    PROMPT="%F{#3a5157}╭─%f${venv_prompt}${user_host} ${current_dir} \$(ruby_prompt_info) ${git_branch}
%F{#3a5157}╰─%f$PR_PROMPT "
  fi
  typeset -g _miami_cruise_transient_prompt="$PR_PROMPT "
  RPROMPT="${return_code}"

  ZSH_THEME_RUBY_PROMPT_PREFIX="%F{#c8414c}‹"
  ZSH_THEME_RUBY_PROMPT_SUFFIX='›%f'
  ZSH_THEME_VIRTUALENV_PREFIX="%F{#c8414c}("
  ZSH_THEME_VIRTUALENV_SUFFIX=')%f '
}

# Use Zsh's hook dispatcher to preserve existing widgets and avoid duplicates.
# Temporary assignments leave the full prompt intact for the next edit.
function miami_cruise_line_finish() {
  [[ ${MIAMI_CRUISE_TRANSIENT_PROMPT:-0} == 1 && -n $BUFFER ]] || return 0
  PROMPT=$_miami_cruise_transient_prompt RPROMPT= zle .reset-prompt
  zle -R
}
if [[ -o interactive ]]; then
  autoload -Uz add-zle-hook-widget
  add-zle-hook-widget line-finish miami_cruise_line_finish
fi
