# Miami Cruise for delta. Generated by build.py; edit themes/delta.py.
# Include this file in your Git config; select ONE named feature.

[delta "miami-cruise-dark"]
    dark = "true"
    syntax-theme = "miami-cruise-dark"
    zero-style = "syntax \"#0d1d22\""
    minus-style = "\"#fd717c\" \"#0d1d22\""
    minus-emph-style = "\"#fd717c\" \"#04161a\" bold ul"
    plus-style = "syntax \"#0d1d22\""
    plus-emph-style = "\"#5ed99e\" \"#04161a\" bold ul"
    minus-non-emph-style = "minus-style"
    plus-non-emph-style = "plus-style"
    minus-empty-line-marker-style = "\"#fd717c\" \"#0d1d22\""
    plus-empty-line-marker-style = "\"#5ed99e\" \"#0d1d22\""
    file-style = "\"#ff7fc0\" bold"
    file-decoration-style = "\"#253c42\" ul"
    hunk-header-style = "file line-number \"#70d5ed\" \"#04161a\""
    hunk-header-file-style = "\"#70d5ed\""
    hunk-header-line-number-style = "\"#ecd065\""
    hunk-header-decoration-style = "\"#253c42\" box"
    line-numbers-left-style = "\"#6a8d94\""
    line-numbers-right-style = "\"#6a8d94\""
    line-numbers-minus-style = "\"#fd717c\""
    line-numbers-plus-style = "\"#5ed99e\""
    line-numbers-zero-style = "\"#6a8d94\""
    commit-style = "\"#d7a0e3\" bold"
    commit-decoration-style = "\"#253c42\" box"
    whitespace-error-style = "\"#0d1d22\" \"#fd717c\""
    keep-plus-minus-markers = "true"

[delta "miami-cruise-light"]
    light = "true"
    syntax-theme = "miami-cruise-light"
    zero-style = "syntax \"#f1f8f9\""
    minus-style = "\"#c8414c\" \"#f1f8f9\""
    minus-emph-style = "\"#c8414c\" \"#f1f8f9\" bold ul"
    plus-style = "syntax \"#f1f8f9\""
    plus-emph-style = "\"#008254\" \"#f1f8f9\" bold ul"
    minus-non-emph-style = "minus-style"
    plus-non-emph-style = "plus-style"
    minus-empty-line-marker-style = "\"#c8414c\" \"#f1f8f9\""
    plus-empty-line-marker-style = "\"#008254\" \"#f1f8f9\""
    file-style = "\"#b51c79\" bold"
    file-decoration-style = "\"#c9dcde\" ul"
    hunk-header-style = "file line-number \"#007c91\" \"#f1f8f9\""
    hunk-header-file-style = "\"#007c91\""
    hunk-header-line-number-style = "\"#906b00\""
    hunk-header-decoration-style = "\"#c9dcde\" box"
    line-numbers-left-style = "\"#566e74\""
    line-numbers-right-style = "\"#566e74\""
    line-numbers-minus-style = "\"#c8414c\""
    line-numbers-plus-style = "\"#008254\""
    line-numbers-zero-style = "\"#566e74\""
    commit-style = "\"#935ba0\" bold"
    commit-decoration-style = "\"#c9dcde\" box"
    whitespace-error-style = "\"#f1f8f9\" \"#c8414c\""
    keep-plus-minus-markers = "true"
